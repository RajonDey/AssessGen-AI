# AssessGen AI — Docker Compose environment
# Copy to .env and adjust as needed.

# Postgres
POSTGRES_USER=assessgen
POSTGRES_PASSWORD=assessgen
POSTGRES_DB=assessgen
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# MinIO (local S3)
MINIO_ROOT_USER=assessgen
MINIO_ROOT_PASSWORD=assessgen-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=assessgen

# Backend (used by dev/generate profiles)
API_PORT=8000
LLM_PROFILE=fast
LLM_MEMORY_BUDGET_GB=11
LLM_LEASE_TTL_SECONDS=900

# Ollama (generate profile — or use host Ollama at localhost:11434)
OLLAMA_PORT=11434
