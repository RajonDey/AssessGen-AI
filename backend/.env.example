# Local development — copy to backend/.env

LLM_PROVIDER=ollama

# Ollama (host)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATOR_MODEL=gemma4:e2b
# Prefer a different critic when possible (ADR-0002).
OLLAMA_REVIEWER_MODEL=gemma4:e2b
# Must match `ollama list`. Optional larger pull: ollama pull gemma4:12b
# Gemma 4 / Qwen3: planner uses think; long generation turns think off (empty `content` otherwise).

# OpenAI-compatible (set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_GENERATOR_MODEL=gpt-4.1-mini
# Use a cheaper/different critic than the generator when available.
OPENAI_REVIEWER_MODEL=gpt-4.1-mini

MAX_REVISION_LOOPS=2
LISTENING_MAX_REVISION_LOOPS=4
# 0 = no read timeout (wait as long as the model needs)
LLM_TIMEOUT_SECONDS=0

# Optional: path to quarantined authentic corpus for publish-mode 8-gram checks.
# NEVER used in generation prompts — overlap test only.
# REFERENCE_DOCUMENTS_PATH=

# Apply Listening N1/pause skeleton when exam-clock structure is missing (default true).
# LISTENING_APPLY_SKELETON=true
